# Database (Postgres + PostGIS)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/myto

# Scheduler (cron calls POST /v1/scheduler/trigger with this header)
CRON_SECRET=your-secret-for-cron-trigger
SCHEDULER_COOLDOWN_MINUTES=60

# Optional: geocoding (Nominatim etc.)
GEOCODE_USER_AGENT=MYTO-Platform/1.0
GEOCODE_RATE_LIMIT_PER_MINUTE=60

# Optional: app
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Frontend → backend internal hop (Next.js Route Handler /api/v1/* proxy).
# Docker Compose sets this to http://backend:8000 (required inside the frontend container).
# Host-local `next dev` + uvicorn: use http://127.0.0.1:8000
# On Vercel: do NOT set BACKEND_URL (service binding injects it); BACKEND_INTERNAL_URL unused.
BACKEND_INTERNAL_URL=http://backend:8000

# Tanna connector (Bearer token for GET /api/v1/tanna/*)
TANNA_CONNECTOR_TOKEN=gridsight-local-token-123

# Supabase (Next.js browser/server clients — not a substitute for DATABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Backend SQLAlchemy still needs the Postgres URI from Supabase → Database settings:
# DATABASE_URL=postgresql://postgres:...@db.YOUR_PROJECT.supabase.co:5432/postgres
